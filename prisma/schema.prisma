datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  VENUE_OWNER
  ADMIN
}

enum IncentiveStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum EventStatus {
  UPCOMING
  LIVE
  ENDED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  venue        Venue?
  createdAt    DateTime @default(now())
}

model Venue {
  id          String      @id @default(cuid())
  ownerId     String      @unique
  owner       User        @relation(fields: [ownerId], references: [id])
  name        String
  address     String
  city        String
  state       String
  zip         String
  lat         Float       @default(0)
  lng         Float       @default(0)
  type        String
  phone       String?
  website     String?
  description String?
  active      Boolean     @default(true)
  incentives  Incentive[]
  events      Event[]
  createdAt   DateTime    @default(now())
}

model Incentive {
  id              String          @id @default(cuid())
  venueId         String
  venue           Venue           @relation(fields: [venueId], references: [id])
  title           String
  description     String
  category        String
  startAt         DateTime
  endAt           DateTime
  maxRedemptions  Int?
  redemptionCount Int             @default(0)
  status          IncentiveStatus @default(ACTIVE)
  terms           String?
  redemptions     Redemption[]
  createdAt       DateTime        @default(now())
}

model Event {
  id          String      @id @default(cuid())
  venueId     String
  venue       Venue       @relation(fields: [venueId], references: [id])
  title       String
  description String?
  date        DateTime
  startTime   String
  endTime     String?
  coverCharge Float?
  imageUrl    String?
  status      EventStatus @default(UPCOMING)
  createdAt   DateTime    @default(now())
}

model Redemption {
  id          String    @id @default(cuid())
  incentiveId String
  incentive   Incentive @relation(fields: [incentiveId], references: [id])
  userId      String
  redeemedAt  DateTime  @default(now())
}
